# ── Configurazione locale: copia questo file in `.env` e valorizza i campi ──
# Il file `.env` NON va mai committato (è in .gitignore).
# Nessuna chiave è obbligatoria nella Fase 0: i moduli senza chiave funzionano
# solo con le fonti che non ne richiedono una.

# SEC EDGAR: obbligatorio come politica fair-access (no key, solo User-Agent).
# Formato consigliato: "NomeProgetto/Contatto email".
SEC_EDGAR_USER_AGENT=MyApp admin@example.com

# Marketaux (news/sentiment): token gratuito 100 req/giorno, no carta.
MARKETAUX_API_TOKEN=

# Stooq (prezzi OHLCV come fallback di yfinance): chiave gratuita via CAPTCHA.
STOOQ_API_KEY=

# Notifiche Telegram (Fase 8): token del bot da @BotFather + chat id della conversazione.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: l'auto-commit dei dati sul repo usa il GITHUB_TOKEN incorporato
# (scope `contents: write`) nei workflow Actions: non serve alcun PAT.